{
  "name": "anyforms-front",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://anyforms.ru",
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "axios": "^1.6.0",
    "jwt-decode": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "three": "^0.183.2",
    "vite": "^5.4.11"
  },
  "scripts": {
    "dev": "vite --host --no-open --mode dev",
    "start": "vite --host",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/prerender.mjs",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "api": "swagger-typescript-api generate -p https://anyforms.ru/v3/api-docs -o ./src/shared/api -n api.gen.ts --axios --union-enums",
    "dev-api": "swagger-typescript-api generate -p http://localhost:8090/v3/api-docs -o ./src/shared/api -n api.gen.ts --axios --union-enums"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "swagger-typescript-api": "^13.0.3"
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf"
}
