# Образец переменных окружения (реальные значения — в .env, .env.dev,
# .env.development, .env.production; они в .gitignore).

# Бэкенд API
VITE_API_URL=https://anyforms-production.up.railway.app

# Google Tag Manager. Разные контейнеры для отладки и прода, чтобы тестовые
# события не смешивались с боевой статистикой:
#   .env.dev / .env.development -> тестовый контейнер (тестовая GA4 property)
#   .env.production             -> боевой контейнер (боевая GA4 property)
# Без переменной GTM просто не подключается.
VITE_GTM_ID=GTM-XXXXXXX

# Необязательно: переопределить метку environment в событиях аналитики
# (по умолчанию: production в prod-сборке, development в dev).
# VITE_ANALYTICS_ENV=staging
