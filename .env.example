# Образец переменных окружения (реальные значения — в .env, .env.dev,
# .env.development, .env.production; они в .gitignore).

# Бэкенд API
VITE_API_URL=https://anyforms-production.up.railway.app

# Аналитика (GTM → GA4). Боевой контейнер захардкожен в src/services/analytics.js
# и грузится ТОЛЬКО на anyforms.ru / www.anyforms.ru (проверка hostname в рантайме).
# Локально и на dev-стендах ничего не отправляется — независимо от типа сборки.
#
# Рубильник (приоритетнее автоматики по домену):
#   VITE_ANALYTICS_ENABLED=false — жёстко выключить всю аналитику (включая VITE_GTM_ID)
#   VITE_ANALYTICS_ENABLED=true  — принудительно включить боевой GTM вне прод-домена
# VITE_ANALYTICS_ENABLED=false

# Для отладки аналитики укажите ТЕСТОВЫЙ контейнер (не боевой!) — он грузится
# и вне прод-домена (его выключает только VITE_ANALYTICS_ENABLED=false):
# VITE_GTM_ID=GTM-XXXXXXX

# Необязательно: переопределить метку environment в событиях аналитики
# (по умолчанию: production на прод-домене, иначе development).
# VITE_ANALYTICS_ENV=staging
